{
  "name": "tokenbar",
  "version": "0.1.0",
  "description": "macOS 메뉴바에서 Claude Code 토큰 사용량을 실시간으로 보는 앱",
  "main": "src/main.js",
  "author": "leetomo2528",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "dev.leetomo.tokenbar",
    "productName": "TokenBar",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "identity": null,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
